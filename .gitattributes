# Linux 目标环境：这几个文件必须是 LF。
# 否则在服务器上会出现 "set: pipefail: invalid option name"（CRLF 害的），
# 或者 .env 里密码结尾多一个 \r 导致连不上库。
*.sh          text eol=lf
Dockerfile    text eol=lf
docker-compose*.yml text eol=lf
*.conf        text eol=lf
*.template    text eol=lf

# Windows 本地脚本保持 CRLF
*.bat         text eol=crlf
*.ps1         text eol=crlf
