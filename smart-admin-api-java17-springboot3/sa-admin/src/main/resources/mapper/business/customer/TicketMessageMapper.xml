<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.business.customer.dao.TicketMessageDao">

    <select id="selectByTicketId" resultType="net.lab1024.sa.admin.module.business.customer.domain.entity.TicketMessageEntity">
        SELECT *
        FROM t_cs_ticket_message
        WHERE ticket_id = #{ticketId}
          AND deleted_flag = 0
        ORDER BY create_time ASC
    </select>

</mapper>